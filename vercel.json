{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/materiais", "permanent": false }
  ],
  "rewrites": [
    { "source": "/materiais/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/materiais/material/:path*", "destination": "/material/:path*" },
    { "source": "/materiais/tokens.css", "destination": "/tokens.css" },
    { "source": "/materiais/colors_and_type.css", "destination": "/colors_and_type.css" },
    { "source": "/materiais", "destination": "/material" },
    { "source": "/materiais/:slug", "destination": "/material" }
  ],
  "headers": [
    {
      "source": "/materiais/material/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    },
    {
      "source": "/material/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
